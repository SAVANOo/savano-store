{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Savano Store Catalog",
  "description": "Contrato oficial do catalog.json da Savano Store, compatível com release-manifest.json.",
  "type": "object",
  "required": ["schemaVersion", "storeName", "updatedAt", "apps"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "storeName": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "apps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CatalogAppEntry"
      }
    }
  },
  "definitions": {
    "CatalogAppEntry": {
      "type": "object",
      "required": [
        "packageId",
        "name",
        "tagline",
        "iconUrl",
        "versionName",
        "versionCode",
        "abi",
        "apkUrl",
        "sizeBytes",
        "sha256",
        "releasedAt",
        "changelog"
      ],
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(\\.[a-zA-Z][a-zA-Z0-9_]*)+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tagline": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "iconUrl": {
          "type": "string",
          "format": "uri"
        },
        "versionName": {
          "type": "string",
          "minLength": 1
        },
        "versionCode": {
          "type": "integer",
          "minimum": 1
        },
        "abi": {
          "type": "string",
          "enum": ["universal", "arm64-v8a", "armeabi-v7a", "x86_64"]
        },
        "apkUrl": {
          "type": "string",
          "format": "uri"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "releasedAt": {
          "type": "string",
          "format": "date-time"
        },
        "changelog": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minSdkVersion": {
          "type": "integer",
          "minimum": 21
        }
      }
    }
  }
}
